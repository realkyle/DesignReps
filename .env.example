# Copy to .env and fill in from Supabase → Project Settings → API Keys.
# Both values are bundled into the app (public by design; data is protected by RLS).
# NEVER put the secret / service_role key here.
#
# EAS builds don't upload .env (it's gitignored), so every variable below must also
# be set in EAS for the "preview" and "production" environments (see eas.json),
# as plaintext: it ships in the app, so "secret" visibility would add nothing.
#   npx eas-cli@latest env:set --name <NAME> --environment preview --environment production --visibility plaintext
# (Leave out --value and type it at the prompt, so it stays out of shell history.)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
